<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification icon and the order chime are only referenced by name from
  Dart at runtime, so the resource shrinker cannot see they are used and
  strips them from release builds (which made every notification fail with
  invalid_icon).
-->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@raw/order_alert,@raw/waiter_call"
    tools:shrinkMode="safe" />
